generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  AGENT
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
  ARCHIVED
}

model Agency {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(160)
  ownerId          String?          @unique @map("owner_id") @db.Uuid
  subscriptionTier SubscriptionTier @default(STARTER) @map("subscription_tier")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner            User?            @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users            User[]           @relation("AgencyUsers")
  properties       Property[]

  @@index([name])
  @@index([subscriptionTier])
  @@map("agencies")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.VarChar(320)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  agencyId          String     @map("agency_id") @db.Uuid
  role              UserRole   @default(AGENT)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  agency            Agency     @relation("AgencyUsers", fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownedAgency       Agency?    @relation("AgencyOwner")
  createdProperties Property[] @relation("PropertyCreator")

  @@index([agencyId])
  @@index([agencyId, role])
  @@index([createdAt])
  @@map("users")
}

model Property {
  id        String         @id @default(uuid()) @db.Uuid
  agencyId  String         @map("agency_id") @db.Uuid
  address   String         @db.VarChar(500)
  price     Decimal        @db.Decimal(18, 2)
  status    PropertyStatus @default(DRAFT)
  createdBy String         @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  agency    Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator   User           @relation("PropertyCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([agencyId])
  @@index([agencyId, status])
  @@index([agencyId, createdAt])
  @@index([createdBy])
  @@map("properties")
}
