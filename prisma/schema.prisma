generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  OFF_MARKET
}

enum PropertyPurpose {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  OFFICE
  SHOP
  WAREHOUSE
  BUILDING
  OTHER
}

enum Currency {
  USD
  IQD
}

enum PropertyMediaType {
  IMAGE
  VIDEO
  PDF
  FLOOR_PLAN
  TOUR_360
}

enum ClientRoleType {
  BUYER
  SELLER
  LANDLORD
  TENANT
  INVESTOR
  DEVELOPER
}

enum ClientLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NURTURING
  CONVERTED
  LOST
}

enum ClientLeadSource {
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  PROPERTY_PORTAL
  WALK_IN
  PHONE
  OTHER
}

enum ClientPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ClientActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VIEWING
  NOTE
  OFFER
  DEAL_CREATED
}

enum DealType {
  SALE
  RENTAL
  LEASE
  DEVELOPMENT
  INVESTMENT
  OTHER
}

enum DealStage {
  NEW_LEAD
  QUALIFIED
  PROPERTY_MATCHED
  VIEWING_SCHEDULED
  OFFER_SUBMITTED
  NEGOTIATION
  CONTRACT
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

model Agency {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(160)
  ownerId          String?          @unique @map("owner_id") @db.Uuid
  subscriptionTier SubscriptionTier @default(STARTER) @map("subscription_tier")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner            User?            @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users            User[]           @relation("AgencyUsers")
  properties       Property[]
  amenities        Amenity[]
  propertyTags     PropertyTag[]
  clients          Client[]
  clientTags       ClientTag[]
  deals            Deal[]

  @@index([name])
  @@index([subscriptionTier])
  @@map("agencies")
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique @db.VarChar(320)
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  agencyId           String             @map("agency_id") @db.Uuid
  role               UserRole           @default(AGENT)
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  agency             Agency             @relation("AgencyUsers", fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownedAgency        Agency?            @relation("AgencyOwner")
  createdProperties  Property[]         @relation("PropertyCreator")
  assignedProperties Property[]         @relation("PropertyAssignedAgent")
  refreshTokens      RefreshToken[]
  uploadedMedia      PropertyMedia[]    @relation("PropertyMediaUploader")
  assignedClients    Client[]           @relation("ClientAssignedAgent")
  clientActivities   ClientActivity[]   @relation("ClientActivityCreator")
  assignedDeals      Deal[]             @relation("DealAssignedAgent")
  createdDeals       Deal[]             @relation("DealCreator")
  dealStageChanges   DealStageHistory[] @relation("DealStageChanger")
  dealNotes          DealNote[]         @relation("DealNoteCreator")

  @@index([agencyId])
  @@index([agencyId, role])
  @@index([agencyId, isActive])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id                String    @id @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  familyId          String    @map("family_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@index([replacedByTokenId])
  @@map("refresh_tokens")
}

model Property {
  id              String                  @id @default(uuid()) @db.Uuid
  agencyId        String                  @map("agency_id") @db.Uuid
  createdById     String                  @map("created_by_id") @db.Uuid
  assignedAgentId String?                 @map("assigned_agent_id") @db.Uuid
  title           String                  @db.VarChar(180)
  description     String?                 @db.Text
  referenceCode   String                  @map("reference_code") @db.VarChar(50)
  purpose         PropertyPurpose
  propertyType    PropertyType            @map("property_type")
  status          PropertyStatus          @default(DRAFT)
  price           Decimal                 @db.Decimal(18, 2)
  currency        Currency
  country         String                  @db.VarChar(100)
  city            String                  @db.VarChar(120)
  district        String?                 @db.VarChar(120)
  neighborhood    String?                 @db.VarChar(160)
  address         String?                 @db.VarChar(500)
  latitude        Decimal?                @db.Decimal(9, 6)
  longitude       Decimal?                @db.Decimal(9, 6)
  bedrooms        Int?
  bathrooms       Int?
  areaSqm         Decimal?                @map("area_sqm") @db.Decimal(14, 2)
  floor           Int?
  totalFloors     Int?                    @map("total_floors")
  parkingSpaces   Int?                    @map("parking_spaces")
  yearBuilt       Int?                    @map("year_built")
  furnished       Boolean                 @default(false)
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?               @map("deleted_at") @db.Timestamptz(3)
  agency          Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator         User                    @relation("PropertyCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedAgent   User?                   @relation("PropertyAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  media           PropertyMedia[]
  amenities       PropertyAmenity[]
  tags            PropertyTagAssignment[]
  deals           Deal[]

  @@unique([agencyId, referenceCode])
  @@index([agencyId, deletedAt])
  @@index([agencyId, status, deletedAt])
  @@index([agencyId, assignedAgentId, deletedAt])
  @@index([agencyId, city, deletedAt])
  @@index([agencyId, propertyType, deletedAt])
  @@index([agencyId, deletedAt, createdAt])
  @@index([createdById])
  @@map("properties")
}

model PropertyMedia {
  id            String            @id @default(uuid()) @db.Uuid
  propertyId    String            @map("property_id") @db.Uuid
  mediaType     PropertyMediaType @map("media_type")
  storagePath   String            @map("storage_path") @db.VarChar(1000)
  thumbnailPath String?           @map("thumbnail_path") @db.VarChar(1000)
  fileName      String            @map("file_name") @db.VarChar(255)
  mimeType      String            @map("mime_type") @db.VarChar(150)
  fileSize      BigInt            @map("file_size")
  width         Int?
  height        Int?
  duration      Int?
  displayOrder  Int               @default(0) @map("display_order")
  isCover       Boolean           @default(false) @map("is_cover")
  metadata      Json?
  uploadedById  String            @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(3)
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy    User              @relation("PropertyMediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([propertyId, deletedAt, displayOrder])
  @@index([propertyId, mediaType, deletedAt])
  @@index([propertyId, isCover, deletedAt])
  @@index([uploadedById])
  @@map("property_media")
}

model Amenity {
  id         String            @id @default(uuid()) @db.Uuid
  agencyId   String            @map("agency_id") @db.Uuid
  name       String            @db.VarChar(120)
  slug       String            @db.VarChar(120)
  icon       String?           @db.VarChar(120)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz(3)
  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  properties PropertyAmenity[]

  @@unique([agencyId, slug])
  @@index([agencyId, deletedAt, name])
  @@map("amenities")
}

model PropertyAmenity {
  propertyId String   @map("property_id") @db.Uuid
  amenityId  String   @map("amenity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
  @@map("property_amenities")
}

model PropertyTag {
  id         String                  @id @default(uuid()) @db.Uuid
  agencyId   String                  @map("agency_id") @db.Uuid
  name       String                  @db.VarChar(120)
  slug       String                  @db.VarChar(120)
  color      String?                 @db.VarChar(7)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?               @map("deleted_at") @db.Timestamptz(3)
  agency     Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  properties PropertyTagAssignment[]

  @@unique([agencyId, slug])
  @@index([agencyId, deletedAt, name])
  @@map("property_tags")
}

model PropertyTagAssignment {
  propertyId String      @map("property_id") @db.Uuid
  tagId      String      @map("tag_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag        PropertyTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([propertyId, tagId])
  @@index([tagId])
  @@map("property_tag_assignments")
}

model Client {
  id                String                @id @default(uuid()) @db.Uuid
  agencyId          String                @map("agency_id") @db.Uuid
  assignedAgentId   String?               @map("assigned_agent_id") @db.Uuid
  firstName         String                @map("first_name") @db.VarChar(100)
  lastName          String                @map("last_name") @db.VarChar(100)
  fullName          String                @map("full_name") @db.VarChar(201)
  email             String?               @db.VarChar(320)
  phone             String                @db.VarChar(30)
  secondaryPhone    String?               @map("secondary_phone") @db.VarChar(30)
  whatsapp          String?               @db.VarChar(30)
  nationality       String?               @db.VarChar(100)
  preferredLanguage String?               @map("preferred_language") @db.VarChar(50)
  company           String?               @db.VarChar(160)
  leadStatus        ClientLeadStatus      @default(NEW) @map("lead_status")
  leadSource        ClientLeadSource?     @map("lead_source")
  priority          ClientPriority        @default(MEDIUM)
  rating            Int?
  notes             String?               @db.Text
  nextFollowUpAt    DateTime?             @map("next_follow_up_at") @db.Timestamptz(3)
  lastContactAt     DateTime?             @map("last_contact_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz(3)
  agency            Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedAgent     User?                 @relation("ClientAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  roles             ClientRole[]
  preferences       ClientPreference[]
  tags              ClientTagAssignment[]
  activities        ClientActivity[]
  deals             Deal[]

  @@index([agencyId, deletedAt, createdAt])
  @@index([agencyId, assignedAgentId, deletedAt])
  @@index([agencyId, leadStatus, deletedAt])
  @@index([agencyId, leadSource, deletedAt])
  @@index([agencyId, priority, deletedAt])
  @@index([agencyId, fullName])
  @@index([agencyId, phone])
  @@index([agencyId, email])
  @@index([assignedAgentId])
  @@map("clients")
}

model ClientRole {
  clientId  String         @map("client_id") @db.Uuid
  role      ClientRoleType
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([clientId, role])
  @@index([role, clientId])
  @@map("client_roles")
}

model ClientPreference {
  id           String       @id @default(uuid()) @db.Uuid
  clientId     String       @map("client_id") @db.Uuid
  propertyType PropertyType @map("property_type")
  city         String       @db.VarChar(120)
  district     String?      @db.VarChar(120)
  bedrooms     Int?
  bathrooms    Int?
  minArea      Decimal?     @map("min_area") @db.Decimal(14, 2)
  maxArea      Decimal?     @map("max_area") @db.Decimal(14, 2)
  minBudget    Decimal?     @map("min_budget") @db.Decimal(18, 2)
  maxBudget    Decimal?     @map("max_budget") @db.Decimal(18, 2)
  currency     Currency
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clientId, deletedAt])
  @@index([propertyType, city])
  @@map("client_preferences")
}

model ClientTag {
  id          String                @id @default(uuid()) @db.Uuid
  agencyId    String                @map("agency_id") @db.Uuid
  name        String                @db.VarChar(120)
  slug        String                @db.VarChar(120)
  color       String?               @db.VarChar(7)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?             @map("deleted_at") @db.Timestamptz(3)
  agency      Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignments ClientTagAssignment[]

  @@unique([agencyId, slug])
  @@index([agencyId, deletedAt, name])
  @@map("client_tags")
}

model ClientTagAssignment {
  clientId  String    @map("client_id") @db.Uuid
  tagId     String    @map("tag_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag       ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([clientId, tagId])
  @@index([tagId, clientId])
  @@map("client_tag_assignments")
}

model ClientActivity {
  id           String             @id @default(uuid()) @db.Uuid
  clientId     String             @map("client_id") @db.Uuid
  activityType ClientActivityType @map("activity_type")
  description  String             @db.Text
  metadata     Json?
  createdById  String             @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy    User               @relation("ClientActivityCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId, createdAt])
  @@index([createdById])
  @@index([activityType])
  @@map("client_activities")
}

model Deal {
  id                 String             @id @default(uuid()) @db.Uuid
  agencyId           String             @map("agency_id") @db.Uuid
  clientId           String             @map("client_id") @db.Uuid
  propertyId         String             @map("property_id") @db.Uuid
  assignedAgentId    String             @map("assigned_agent_id") @db.Uuid
  title              String             @db.VarChar(180)
  dealType           DealType           @map("deal_type")
  stage              DealStage          @default(NEW_LEAD)
  status             DealStatus         @default(OPEN)
  askingPrice        Decimal?           @map("asking_price") @db.Decimal(18, 2)
  offerAmount        Decimal?           @map("offer_amount") @db.Decimal(18, 2)
  agreedAmount       Decimal?           @map("agreed_amount") @db.Decimal(18, 2)
  currency           Currency
  expectedCommission Decimal?           @map("expected_commission") @db.Decimal(18, 4)
  commissionType     CommissionType?    @map("commission_type")
  expectedCloseAt    DateTime?          @map("expected_close_at") @db.Timestamptz(3)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(3)
  lostReason         String?            @map("lost_reason") @db.VarChar(1000)
  description        String?            @db.Text
  createdById        String             @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(3)
  agency             Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedAgent      User               @relation("DealAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator            User               @relation("DealCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stageHistory       DealStageHistory[]
  notes              DealNote[]

  @@index([agencyId, stage, deletedAt])
  @@index([agencyId, status, deletedAt])
  @@index([agencyId, assignedAgentId, deletedAt])
  @@index([agencyId, expectedCloseAt, deletedAt])
  @@index([agencyId, createdAt, deletedAt])
  @@index([clientId])
  @@index([propertyId])
  @@index([assignedAgentId])
  @@index([createdById])
  @@map("deals")
}

model DealStageHistory {
  id          String     @id @default(uuid()) @db.Uuid
  dealId      String     @map("deal_id") @db.Uuid
  fromStage   DealStage? @map("from_stage")
  toStage     DealStage  @map("to_stage")
  changedById String     @map("changed_by_id") @db.Uuid
  note        String?    @db.VarChar(2000)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  deal        Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy   User       @relation("DealStageChanger", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([dealId, createdAt])
  @@index([changedById])
  @@map("deal_stage_history")
}

model DealNote {
  id          String    @id @default(uuid()) @db.Uuid
  dealId      String    @map("deal_id") @db.Uuid
  body        String    @db.Text
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy   User      @relation("DealNoteCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([dealId, deletedAt, createdAt])
  @@index([createdById])
  @@map("deal_notes")
}
