generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  OFF_MARKET
}

enum PropertyPurpose {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  OFFICE
  SHOP
  WAREHOUSE
  BUILDING
  OTHER
}

enum Currency {
  USD
  IQD
}

model Agency {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(160)
  ownerId          String?          @unique @map("owner_id") @db.Uuid
  subscriptionTier SubscriptionTier @default(STARTER) @map("subscription_tier")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner            User?            @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users            User[]           @relation("AgencyUsers")
  properties       Property[]

  @@index([name])
  @@index([subscriptionTier])
  @@map("agencies")
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique @db.VarChar(320)
  passwordHash       String         @map("password_hash") @db.VarChar(255)
  agencyId           String         @map("agency_id") @db.Uuid
  role               UserRole       @default(AGENT)
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  agency             Agency         @relation("AgencyUsers", fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownedAgency        Agency?        @relation("AgencyOwner")
  createdProperties  Property[]     @relation("PropertyCreator")
  assignedProperties Property[]     @relation("PropertyAssignedAgent")
  refreshTokens      RefreshToken[]

  @@index([agencyId])
  @@index([agencyId, role])
  @@index([agencyId, isActive])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id                String    @id @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  familyId          String    @map("family_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@index([replacedByTokenId])
  @@map("refresh_tokens")
}

model Property {
  id              String          @id @default(uuid()) @db.Uuid
  agencyId        String          @map("agency_id") @db.Uuid
  createdById     String          @map("created_by_id") @db.Uuid
  assignedAgentId String?         @map("assigned_agent_id") @db.Uuid
  title           String          @db.VarChar(180)
  description     String?         @db.Text
  referenceCode   String          @map("reference_code") @db.VarChar(50)
  purpose         PropertyPurpose
  propertyType    PropertyType    @map("property_type")
  status          PropertyStatus  @default(DRAFT)
  price           Decimal         @db.Decimal(18, 2)
  currency        Currency
  country         String          @db.VarChar(100)
  city            String          @db.VarChar(120)
  district        String?         @db.VarChar(120)
  neighborhood    String?         @db.VarChar(160)
  address         String?         @db.VarChar(500)
  latitude        Decimal?        @db.Decimal(9, 6)
  longitude       Decimal?        @db.Decimal(9, 6)
  bedrooms        Int?
  bathrooms       Int?
  areaSqm         Decimal?        @map("area_sqm") @db.Decimal(14, 2)
  floor           Int?
  totalFloors     Int?            @map("total_floors")
  parkingSpaces   Int?            @map("parking_spaces")
  yearBuilt       Int?            @map("year_built")
  furnished       Boolean         @default(false)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  agency          Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator         User            @relation("PropertyCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedAgent   User?           @relation("PropertyAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([agencyId, referenceCode])
  @@index([agencyId, deletedAt])
  @@index([agencyId, status, deletedAt])
  @@index([agencyId, assignedAgentId, deletedAt])
  @@index([agencyId, city, deletedAt])
  @@index([agencyId, propertyType, deletedAt])
  @@index([agencyId, deletedAt, createdAt])
  @@index([createdById])
  @@map("properties")
}
